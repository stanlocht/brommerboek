brommerboek.nl {
    encode gzip

    # FastAPI serves /api/* (routes), /media/* (uploaded stop photos/videos
    # via StaticFiles) and /s/* (per-stop share pages with OG tags for link
    # previews) — all must reach the backend, not the SPA.
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /s/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# Per-PR preview sites (pr-<N>.brommerboek.nl), one snippet per open PR,
# written/removed by .github/workflows/preview.yml. Needs the wildcard DNS
# record *.brommerboek.nl -> this box; Caddy gets a normal per-hostname
# certificate for each preview via the HTTP challenge.
import /etc/caddy/previews/*.caddy
