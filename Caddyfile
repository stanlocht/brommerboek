brommerboek.nl {
    encode gzip

    # FastAPI serves /api/* (routes) and /media/* (uploaded stop photos/videos
    # via StaticFiles) — both must reach the backend, not the SPA.
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
