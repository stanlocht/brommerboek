# Copy to `.env` on the box (never commit the filled-in file). CI does not
# read this — Postgres/app secrets live only on the server.

# --- Postgres ---
POSTGRES_USER=brommer
POSTGRES_PASSWORD=CHANGEME-long-random-string
POSTGRES_DB=brommerboek

# --- App / FastAPI ---
DOMAIN=brommerboek.nl
ENVIRONMENT=production
FRONTEND_HOST=https://brommerboek.nl
BACKEND_CORS_ORIGINS=https://brommerboek.nl
SECRET_KEY=CHANGEME-generate-with-openssl-rand-hex-32
FIRST_SUPERUSER=you@example.com
FIRST_SUPERUSER_PASSWORD=CHANGEME
PROJECT_NAME=Brommerboek
# Set to True to allow anyone to create an account via /users/signup
USERS_OPEN_REGISTRATION=False

# --- Web Push (optional; leave blank to disable "volg de reis" meldingen) ---
# Generate per docs/RUNBOOK.md ("Web Push notificaties").
VAPID_PRIVATE_KEY=
# Operator contact the browser push relays may use; defaults to
# EMAILS_FROM_EMAIL or FIRST_SUPERUSER when left blank.
VAPID_CLAIMS_EMAIL=

# --- Email (optional; leave blank to disable outbound mail) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# --- Observability (optional) ---
SENTRY_DSN=
