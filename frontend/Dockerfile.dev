FROM oven/bun:1

WORKDIR /app/frontend

COPY frontend/package.json frontend/bun.lock /app/frontend/

RUN bun install

COPY ./frontend /app/frontend

# Reliable file watching on bind-mounted source (esp. macOS/WSL)
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 5173

CMD ["sh", "-c", "bun install && bun run dev -- --host 0.0.0.0"]
