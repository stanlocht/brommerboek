<mjml>
  <!-- Vintage road-atlas idiom, matching frontend/src/brommerboek/theme.ts.
       No remote assets: the fonts are the theme's own web-safe fallbacks
       (Georgia / Courier New) so the mail renders the same whether or not
       the client blocks remote content. -->
  <mj-head>
    <mj-title>{{ project_name }} — testbericht</mj-title>
    <mj-preview>Als je dit leest, werkt de e-mail van {{ project_name }}.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-attributes>
      <mj-body background-color="#efe4c9" />
      <mj-text color="#3a332a" font-size="15px" line-height="1.5" font-family="'Zilla Slab', Georgia, serif" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#efe4c9">
    <mj-section padding="28px 12px 8px">
      <mj-column>
        <mj-text align="center" font-family="'Special Elite', 'Courier New', monospace" font-size="11px" letter-spacing="3px" color="#9c6b3a" padding="0">
          {{ project_name|upper }} · TESTBERICHT
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f4ecd6" border="1.5px solid #cbb187" border-radius="12px" padding="22px 18px 26px">
      <mj-column>
        <mj-text align="center" font-size="30px" font-weight="700" line-height="1.1" padding="0 0 10px">
          Testbericht
        </mj-text>

        <mj-divider border-color="#c0362c" border-width="2px" border-style="dashed" padding="4px 0 16px" />

        <mj-text align="center" padding="0 6px 12px">
          Als je dit leest, werkt de uitgaande e-mail van {{ project_name }}.
        </mj-text>

        <mj-text align="center" font-family="'Special Elite', 'Courier New', monospace" font-size="12px" color="#7a6f5a" padding="0 6px">
          verstuurd naar {{ email }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="14px 12px 30px">
      <mj-column>
        <mj-text align="center" font-family="'Special Elite', 'Courier New', monospace" font-size="11px" color="#7a6f5a" padding="0">
          een test vanuit de machinekamer — je hoeft niets te doen
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
