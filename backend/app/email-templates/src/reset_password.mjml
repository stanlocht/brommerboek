<mjml>
  <!-- Vintage road-atlas idiom, matching frontend/src/brommerboek/theme.ts.
       No remote assets: the fonts are the theme's own web-safe fallbacks
       (Georgia / Courier New) so the mail renders the same whether or not
       the client blocks remote content. -->
  <mj-head>
    <mj-title>{{ project_name }} — wachtwoord herstellen</mj-title>
    <mj-preview>Kies binnen {{ valid_hours }} uur een nieuw wachtwoord.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-attributes>
      <mj-body background-color="#efe4c9" />
      <mj-text color="#3a332a" font-size="15px" line-height="1.5" font-family="'Zilla Slab', Georgia, serif" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#efe4c9">
    <mj-section padding="28px 12px 8px">
      <mj-column>
        <mj-text align="center" font-family="'Special Elite', 'Courier New', monospace" font-size="11px" letter-spacing="3px" color="#9c6b3a" padding="0">
          {{ project_name|upper }} · WACHTWOORD
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f4ecd6" border="1.5px solid #cbb187" border-radius="12px" padding="22px 18px 26px">
      <mj-column>
        <mj-text align="center" font-size="30px" font-weight="700" line-height="1.1" padding="0 0 10px">
          Wachtwoord herstellen
        </mj-text>

        <mj-divider border-color="#c0362c" border-width="2px" border-style="dashed" padding="4px 0 16px" />

        <mj-text padding="0 6px 10px">
          Hallo {{ username }},
        </mj-text>

        <mj-text padding="0 6px 16px">
          Er is een verzoek binnengekomen om het wachtwoord van je
          {{ project_name }}-account opnieuw in te stellen. Kies hieronder een
          nieuw wachtwoord.
        </mj-text>

        <mj-button href="{{ link }}" background-color="#a3302a" color="#f3e7c9" border-radius="10px" font-family="'Special Elite', 'Courier New', monospace" font-size="14px" letter-spacing="1px" inner-padding="13px 24px" padding="0 6px 18px">
          kies een nieuw wachtwoord
        </mj-button>

        <mj-text font-family="'Special Elite', 'Courier New', monospace" font-size="11px" color="#7a6f5a" padding="0 6px 6px">
          werkt de knop niet? plak deze link in je browser:
        </mj-text>

        <mj-text font-family="'Special Elite', 'Courier New', monospace" font-size="11px" padding="0 6px 16px">
          <a href="{{ link }}" style="color:#9c6b3a;word-break:break-all;">{{ link }}</a>
        </mj-text>

        <mj-divider border-color="#d8c79c" border-width="1px" padding="0 6px 14px" />

        <mj-text font-family="'Special Elite', 'Courier New', monospace" font-size="11px" color="#7a6f5a" padding="0 6px">
          de link verloopt over {{ valid_hours }} uur
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="14px 12px 30px">
      <mj-column>
        <mj-text align="center" font-family="'Special Elite', 'Courier New', monospace" font-size="11px" color="#7a6f5a" padding="0">
          geen herstel aangevraagd? dan hoef je niets te doen —<br />
          je wachtwoord blijft ongewijzigd
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
